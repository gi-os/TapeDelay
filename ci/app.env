APP_NAME="Delay of Game"
SCHEME="TapeDelay"
TARGETS="TapeDelay:com.gios.tapedelay,TapeDelayWidgets:com.gios.tapedelay.widgets"
THIRD_PARTY_CONTENT="true"
APP_GROUP=""
PUSH_BUNDLE="com.gios.tapedelay"
# iPhone Duo runs an app full screen, edge to edge on both displays, only when it is built with
# the iOS 27.1 SDK. ci/select-xcode.sh refuses anything older.
XCODE="27.1"
RUNNER="xcode-27"
# Team logos are baked in at build time (a Live Activity can't download them).
PREPARE="python3 ci/fetch_logos.py Logos"
